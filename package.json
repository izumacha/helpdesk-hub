{
  "name": "helpdesk-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:contract": "vitest run --no-file-parallelism tests/data/*.contract.prisma.test.ts",
    "test:e2e": "playwright test",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@node-saml/node-saml": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "stripe": "^23.0.1",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "mysql2": "^3.24.4"
  }
}
